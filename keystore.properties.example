# Release signing for Phone. Copy this file to keystore.properties (git ignores it) and fill it in,
# or set PHONE_KEYSTORE_FILE, PHONE_KEYSTORE_PASSWORD, PHONE_KEY_ALIAS and PHONE_KEY_PASSWORD.
# Without either, release builds are signed with the debug key so they still install for testing.
#
# Make a key once with:
#   keytool -genkeypair -v -keystore release.jks -alias phone -keyalg RSA -keysize 4096 -validity 10000
storeFile=release.jks
storePassword=
keyAlias=phone
keyPassword=
