<resources>
    <!-- The theme of every Compose screen: no action bar, bars drawn by the content edge to edge,
         and a solid background so nothing flashes before the first frame. The night variant
         swaps the parent and the colors. -->
    <style name="Theme.Pvot" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/pvot_window_background</item>
        <item name="android:colorBackground">@color/pvot_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <!-- The call screens: shown over the lock screen, with no window animation between the
         call activity's own screens and no wallpaper, since the screen draws its own background. -->
    <style name="Theme.Pvot.InCall">
        <item name="android:windowBackground">@color/pvot_incall_window_background</item>
        <item name="android:colorBackground">@color/pvot_incall_window_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <!-- The launcher's splash, handing over to Theme.Pvot once the first screen is up. -->
    <style name="Theme.Pvot.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pvot_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Pvot</item>
    </style>

    <!-- A bridge for the screens still built on AppCompat views, until they move to Compose:
         the same bars and background as Theme.Pvot, on an AppCompat parent. -->
    <style name="Theme.Pvot.Legacy" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/pvot_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <!-- A see-through window for activities that only show a Pvot sheet or dialog over the previous
         screen. The sheet or dialog draws its own scrim. -->
    <style name="Theme.Pvot.Transparent" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
