<!-- On a wide window the tabs' navigation is a rail at the start instead of a bar at the bottom;
     the same views, so the main screen's code is the same. -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
  <!-- Nav rail (Compose) -->
  <androidx.compose.ui.platform.ComposeView
      android:id="@+id/bottom_nav_bar"
      android:layout_width="wrap_content"
      android:layout_height="match_parent"
      android:layout_alignParentStart="true"/>
  <!-- MainToolbar -->
  <org.prauga.phone.dialer.main.impl.toolbar.MainToolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_toEndOf="@+id/bottom_nav_bar"/>
  <androidx.coordinatorlayout.widget.CoordinatorLayout
      android:id="@+id/coordinator_layout"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_below="@+id/toolbar"
      android:layout_toEndOf="@+id/bottom_nav_bar"
      android:layout_alignParentBottom="true">
    <!-- Holds SpeedDial, Call Log, Contacts, Voicemail and Search fragments. -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/search_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
  </androidx.coordinatorlayout.widget.CoordinatorLayout>
  <!-- Holds Dialpad fragment, the dialpad tab's keypad at the bottom of the content. -->
  <FrameLayout
      android:id="@+id/dialpad_fragment_container"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_toEndOf="@+id/bottom_nav_bar"
      android:layout_alignParentBottom="true"
      android:elevation="10dp"/>
  <!-- Snackbars, at the bottom of the content beside the rail (Compose) -->
  <androidx.compose.ui.platform.ComposeView
      android:id="@+id/main_snackbars"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_toEndOf="@+id/bottom_nav_bar"
      android:layout_alignParentBottom="true"
      android:elevation="12dp"/>
  <!-- Host container for the contact tile drag shadow -->
  <FrameLayout
      android:id="@+id/activity_overlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent">
    <ImageView
        android:id="@+id/contact_tile_drag_shadow_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:visibility="gone"/>
  </FrameLayout>
</RelativeLayout>
